# ==============================================================================
# ANGLES NATURAL — VARIABLES DE ENTORNO
# ==============================================================================
# La plataforma opera en MODO HÍBRIDO:
# Si las variables de Firebase no están configuradas, el sistema funciona
# automáticamente con almacenamiento local (localStorage + Seeds precargados)
# para pruebas, desarrollo y evaluación instantánea sin dependencias externas.
# ==============================================================================

# WhatsApp Business para pedidos directos
NEXT_PUBLIC_WHATSAPP_PHONE=59170000000

# Configuración Opcional de Firebase (Autenticación, Firestore, Storage)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=angles-natural.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=angles-natural
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=angles-natural.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
